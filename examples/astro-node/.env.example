# Copy to .env (never commit it) or set these in your process manager. Read from process.env at run time.

# CCP Website chat integration: values from the CCP "Website chat" page.
DEWEE_CCP_CHAT_URL=https://app.dewee.sh/api/public/webchat/v1/wci_replace_with_your_id
DEWEE_WEBCHAT_INTEGRATION_ID=
# dwc_… secret, server-side only
DEWEE_WEBCHAT_INTEGRATION_SECRET=
# >= 32 random characters, the same on every instance:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEWEE_WEBCHAT_SECRET=
# Behind a reverse proxy or load balancer, list the site's own public origin here too: the server
# sees its internal address, not the one the browser sends. Other sites allowed to call this backend
# go here as well (comma-separated origins).
# DEWEE_ALLOWED_ORIGINS=https://shop.example.com
# The public origin the host's own login and payment routes accept (same reason).
# SITE_ORIGIN=https://shop.example.com

# Optional: signed-in users (`dewee identity setup` prints the id and the assertion secret).
# Leave DEWEE_IDENTITY_APP_ID empty for anonymous visitors only.
DEWEE_IDENTITY_APP_ID=
DEWEE_IDENTITY_ISSUER=
DEWEE_IDENTITY_ASSERTION_SECRET=

# The demo login cookie and payment quotes (>= 32 random characters, the same on every instance).
DEMO_LOGIN_SECRET=
# Payment provider checkout base (https). The demo builds checkout links from it.
PAYMENT_CHECKOUT_URL=https://pay.example.test/checkout

# Node server
HOST=127.0.0.1
PORT=4322
