{
  "name": "dewee-webchat",
  "version": "0.4.1-beta.1",
  "description": "Embeddable chat widget for Dewee AI agents — web component, React/Vue/Astro wrappers and a secure backend handler (Workers, Next.js, Node, Bun, Deno).",
  "license": "MIT",
  "type": "module",
  "author": "NextLevelBuilder <hi@nextlevelbuilder.io>",
  "homepage": "https://webchat.dewee.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlevelbuilder/dewee-webchat.git",
    "directory": "packages/dewee-webchat"
  },
  "bugs": "https://github.com/nextlevelbuilder/dewee-webchat/issues",
  "keywords": [
    "dewee",
    "goclaw",
    "ai",
    "agent",
    "chatbot",
    "chat-widget",
    "web-component",
    "react",
    "vue",
    "astro",
    "nextjs",
    "cloudflare-workers"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/dewee-webchat.js",
    "./dist/chunk-*.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/dewee-webchat.js",
  "jsdelivr": "./dist/dewee-webchat.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/identity": {
      "types": "./dist/server-identity.d.ts",
      "import": "./dist/server-identity.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./astro": "./astro/DeweeChat.astro",
    "./cdn": "./dist/dewee-webchat.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "astro",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:bundlers": "node scripts/bundler-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@dewee/identity": ">=0.1.0-beta.0 <1",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@dewee/identity": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dewee/identity": "file:../../vendor/dewee-identity-0.1.0-beta.0.tgz",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "webpack": "^5.112.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
