# Dewee gateway (runtime origin, not the control-plane URL)
DEWEE_GATEWAY_URL=https://your-gateway.example.com
# Operator API key (scopes operator.read,operator.write) or gateway token. Server-side only.
DEWEE_GATEWAY_TOKEN=
# Optional tenant UUID
DEWEE_TENANT_ID=
# Random 32+ byte string used to sign visitor sessions (openssl rand -base64 32)
DEWEE_WEBCHAT_SECRET=
# Agents visitors may talk to: comma list, or * for all
DEWEE_AGENTS=support-agent
DEWEE_DEFAULT_AGENT=support-agent
# Extra origins allowed to call the backend cross-origin (same-origin always works)
DEWEE_ALLOWED_ORIGINS=
# Let the widget send its own gateway URL/token (playgrounds only)
DEWEE_ALLOW_CLIENT_CREDENTIALS=false
DEWEE_CLIENT_CREDENTIAL_HOSTS=
# Optional Cloudflare Turnstile bot check
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: signed-in users through Dewee (read in your code and passed as the handler's `identity`
# option together with your authenticate(req) callback). From `dewee identity setup`. Server-side only.
DEWEE_IDENTITY_APP_ID=
DEWEE_IDENTITY_ISSUER=
DEWEE_IDENTITY_ASSERTION_SECRET=
