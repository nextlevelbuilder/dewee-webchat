exports[`legacy-gateway transport: browser responses > chat stream 1`] = `
{
  "body": "data: {"type":"start","conversationId":"conv_abc123","agent":"sales"}

data: {"type":"thinking","text":"Let me check."}

data: {"type":"tool_call","id":"t1","name":"search","arguments":{"q":"x"}}

data: {"type":"tool_result","id":"t1","name":"search","isError":false,"result":"found"}

data: {"type":"delta","text":"Hello "}

data: {"type":"delta","text":"world"}

data: {"type":"done","content":"Hello world","usage":{"total_tokens":42}}

",
  "headers": {
    "cache-control": "no-cache, no-transform",
    "content-type": "text/event-stream; charset=utf-8",
    "x-accel-buffering": "no",
  },
  "status": 200,
}
`;

exports[`legacy-gateway transport: browser responses > chat stream with a run failure 1`] = `
